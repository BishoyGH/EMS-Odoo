<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_ems_statement" model="ir.actions.report">
        <field name="name">EMS Customer Statement</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ems_payments.report_ems_statement</field>
        <field name="print_report_name">'Statement - %s' % object.name</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_ems_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="partner">
                <t t-set="st" t-value="statements[partner.id]"/>
                    <t t-set="company" t-value="env.company"/>
                    <t t-set="doc_title">CUSTOMER STATEMENT</t>
                    <t t-set="doc_ref"><span t-out="partner.name"/> · as of <span t-out="today" t-options="{'widget': 'date'}"/></t>
                <t t-call="ems_base.ems_report_page">
                    <table class="ems-grid">
                        <thead><tr><th>Project</th><th>Invoice</th><th>Date</th><th>Due</th><th class="ems-num">Amount</th><th class="ems-num">Received</th><th class="ems-num">Balance</th><th class="ems-num">Days late</th></tr></thead>
                        <tbody>
                            <tr t-foreach="st['rows']" t-as="r">
                                <td t-out="r['project']"/><td t-out="r['name']"/>
                                <td><span t-out="r['date']" t-options="{'widget': 'date'}"/></td>
                                <td><span t-out="r['due']" t-options="{'widget': 'date'}"/></td>
                                <td class="ems-num"><span t-out="r['amount']" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                <td class="ems-num"><span t-out="r['received']" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                <td class="ems-num"><span t-out="r['balance']" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                <td class="ems-num"><t t-if="r['late']" t-out="r['late']"/><t t-else="">—</t></td>
                            </tr>
                            <tr><td colspan="6" class="ems-num"><strong>Total outstanding</strong></td>
                                <td class="ems-num"><strong t-out="st['total']" t-options="{'widget': 'float', 'precision': 2}"/></td><td/></tr>
                        </tbody>
                    </table>
                    <table class="ems-grid" style="width:70%">
                        <tr><th>Not due</th><th>1–30</th><th>31–60</th><th>61–90</th><th>90+</th></tr>
                        <tr><td t-foreach="st['buckets']" t-as="b" class="ems-num"><span t-out="b" t-options="{'widget': 'float', 'precision': 2}"/></td></tr>
                    </table>
                    <p>Please remit to <span t-out="env.company.name"/>
                        <t t-set="bank" t-value="env.company.partner_id.bank_ids[:1]"/>
                        <t t-if="bank"> · Bank: <span t-out="bank.bank_name"/> · IBAN: <span t-out="bank.account_number"/></t>
                        · quoting the invoice numbers.</p>
                </t>
            </t>
        </t>
    </template>
</odoo>
