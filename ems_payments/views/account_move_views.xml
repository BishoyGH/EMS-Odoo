<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ems" model="ir.ui.view">
        <field name="name">account.move.form.ems</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="EMS Follow-up" name="ems_followup" invisible="move_type != 'out_invoice'"
                      groups="ems_base.group_ems_user">
                    <group>
                        <group>
                            <field name="ems_project_id"/>
                            <field name="ems_fee_stage_id"/>
                            <field name="ems_days_overdue"/>
                            <field name="ems_follow_up_date"/>
                            <field name="ems_follow_up_method"/>
                            <field name="ems_follow_up_notes"/>
                        </group>
                        <group>
                            <field name="ems_client_response"/>
                            <field name="ems_next_follow_up"/>
                            <field name="ems_next_follow_up_method"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_ems_client_invoice_list" model="ir.ui.view">
        <field name="name">ems.client.invoice.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list decoration-danger="ems_days_overdue &gt; 0" decoration-success="payment_state == 'paid'">
                <field name="name"/>
                <field name="ems_project_id"/>
                <field name="partner_id"/>
                <field name="invoice_date"/>
                <field name="invoice_date_due"/>
                <field name="ems_days_overdue"/>
                <field name="ems_next_follow_up"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_untaxed_signed" sum="Total" string="Ex VAT"/>
                <field name="amount_residual_signed" sum="Total" string="Outstanding"/>
                <field name="payment_state" widget="badge"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_ems_client_invoice_search" model="ir.ui.view">
        <field name="name">ems.client.invoice.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="ems_project_id"/>
                <filter name="unpaid" string="Outstanding" domain="[('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]"/>
                <filter name="overdue" string="Overdue" domain="[('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial')), ('invoice_date_due', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="has_followup" string="Has Follow-up Date" domain="[('ems_next_follow_up', '!=', False)]"/>
                <group>
                    <filter name="g_project" string="Project" context="{'group_by': 'ems_project_id'}"/>
                    <filter name="g_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="g_state" string="Payment Status" context="{'group_by': 'payment_state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_ems_client_invoice_pivot" model="ir.ui.view">
        <field name="name">ems.client.invoice.pivot</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="partner_id" type="row"/>
                <field name="payment_state" type="col"/>
                <field name="amount_untaxed_signed" type="measure"/>
                <field name="amount_residual_signed" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_ems_client_invoices" model="ir.actions.act_window">
        <field name="name">Client Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="domain">[('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="search_view_id" ref="view_ems_client_invoice_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_ems_client_invoice_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_ems_client_invoice_pivot')})]"/>
    </record>
    <record id="action_ems_payment_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_ems_client_invoice_pivot')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_ems_client_invoice_list')})]"/>
    </record>
    <record id="action_ems_payment_followups" model="ir.actions.act_window">
        <field name="name">Follow-ups</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]</field>
        <field name="context">{'search_default_unpaid': 1}</field>
        <field name="search_view_id" ref="view_ems_client_invoice_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_ems_client_invoice_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
    </record>
</odoo>
