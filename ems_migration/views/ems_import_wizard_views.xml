<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ems_import_wizard" model="ir.ui.view">
        <field name="name">ems.import.wizard.form</field>
        <field name="model">ems.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Excel Import">
                <group>
                    <field name="kind"/>
                </group>
                <group string="1. Download the template (with data dictionary)">
                    <field name="template_file" filename="template_filename" readonly="1" invisible="not template_file"/>
                    <field name="template_filename" invisible="1"/>
                    <button name="action_download_template" string="Generate Template" type="object" class="btn-secondary"/>
                </group>
                <group string="2. Upload the filled template">
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <field name="result" invisible="not result" readonly="1"/>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_ems_import_wizard" model="ir.actions.act_window">
        <field name="name">Excel Import Templates</field>
        <field name="res_model">ems.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
