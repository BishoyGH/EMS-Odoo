<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ems_migration_run_list" model="ir.ui.view">
        <field name="name">ems.migration.run.list</field>
        <field name="model">ems.migration.run</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="filename"/><field name="issue_count"/><field name="state" widget="badge"/></list>
        </field>
    </record>
    <record id="view_ems_migration_run_form" model="ir.ui.view">
        <field name="name">ems.migration.run.form</field>
        <field name="model">ems.migration.run</field>
        <field name="arch" type="xml">
            <form string="Migration">
                <header>
                    <button name="action_run" string="Run Migration" type="object" class="btn-primary"
                            confirm="Reads the backup and creates or updates records. Safe to run again. Continue?"/>
                    <button name="action_view_issues" string="Data Issues" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        The backup is real client data. It is read-only and never stored beyond the import.
                        Cost rates, bank and MOL details are encrypted in the exe and are not migrated.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="include_invoices"/>
                            <field name="include_chatter"/>
                            <field name="issue_count"/>
                        </group>
                    </group>
                    <field name="summary_ids">
                        <list><field name="table"/><field name="created"/><field name="updated"/><field name="skipped"/><field name="failed"/></list>
                    </field>
                    <field name="log"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_ems_migration_run" model="ir.actions.act_window">
        <field name="name">Migration from .dat</field>
        <field name="res_model">ems.migration.run</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
