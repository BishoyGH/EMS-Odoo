<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_ems_offer" model="ir.actions.report">
        <field name="name">Offer Letter</field>
        <field name="model">ems.offer</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ems_people.report_ems_offer</field>
        <field name="print_report_name">'Offer Letter - %s' % object.name</field>
        <field name="binding_model_id" ref="model_ems_offer"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_ems_offer">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                    <t t-set="company" t-value="o.company_id"/>
                    <t t-set="doc_title">OFFER OF EMPLOYMENT</t>
                    <t t-set="doc_ref"><span t-out="o.name"/> · <span t-out="o.offer_date" t-options="{'widget': 'date'}"/></t>
                <t t-call="ems_base.ems_report_page">
                    <p>Dear <t t-out="o.candidate"/>,</p>
                    <p>We are pleased to offer you the position of <strong t-out="o.job_id.name"/>
                        <t t-if="o.department_id"> in our <span t-out="o.department_id.name"/> department</t>
                        <t t-if="o.manager_id">, reporting to <span t-out="o.manager_id.name"/></t>, on the following terms:</p>
                    <div t-if="not is_html_empty(o.letter_body)" t-out="o.letter_body"/>
                    <table class="ems-grid">
                        <tr><th style="width:30%">Start date</th><td><span t-out="o.start_date" t-options="{'widget': 'date'}"/></td></tr>
                        <tr><th>Probation</th><td><span t-out="o.probation_months"/> months</td></tr>
                        <tr t-if="env.user.has_group('ems_base.group_ems_rates')">
                            <th>Monthly package (gross)</th>
                            <td>Basic <span t-out="o.salary_basic" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/> ·
                                Housing <span t-out="o.salary_housing" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/> ·
                                Transport <span t-out="o.salary_transport" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/> ·
                                <t t-if="o.salary_other">Other <span t-out="o.salary_other" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/> · </t>
                                <strong>Total <span t-out="o.salary_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong></td>
                        </tr>
                        <tr><th>Annual leave</th><td><span t-out="o.leave_days"/> calendar days per year</td></tr>
                        <tr><th>Benefits</th><td><t t-if="o.air_ticket">Air ticket: <span t-out="o.air_ticket"/>. </t><span t-out="o.benefits"/></td></tr>
                        <tr><th>Notice period</th><td><span t-out="o.notice_days"/> days</td></tr>
                        <tr t-if="o.non_compete"><th>Non-compete</th><td>Applies, as set out in the employment contract.</td></tr>
                    </table>
                    <t t-if="not is_html_empty(o.job_description)"><p><strong>Job description.</strong></p><div t-out="o.job_description"/></t>
                    <p t-if="o.valid_until">This offer is valid until <span t-out="o.valid_until" t-options="{'widget': 'date'}"/>. Please sign and return a copy to confirm your acceptance.</p>
                    <div style="margin-top:30px; page-break-inside: avoid">
                            <t t-set="left_note"><span t-out="o.signatory_id.name"/></t>
                            <t t-set="right_title">Accepted by the candidate</t>
                            <t t-set="right_note">Signature / date</t>
                        <t t-call="ems_base.ems_signature_block">
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
