<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ems_grade_list" model="ir.ui.view">
        <field name="name">ems.grade.list</field>
        <field name="model">ems.grade</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="cost_rate" groups="ems_base.group_ems_rates"/>
                <field name="charge_rate" groups="ems_base.group_ems_rates"/>
            </list>
        </field>
    </record>
    <record id="action_ems_grade" model="ir.actions.act_window">
        <field name="name">Grades &amp; Rates</field>
        <field name="res_model">ems.grade</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
