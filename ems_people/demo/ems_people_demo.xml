    <record id="emp_suzanne" model="hr.employee"><field name="name">Suzanne Alboudi</field><field name="ems_code">E005</field><field name="ems_grade_id" ref="grade_engineer"/></record>
    <record id="emp_michellyn" model="hr.employee"><field name="name">Michellyn Abaquin</field><field name="ems_code">E006</field><field name="ems_grade_id" ref="grade_junior"/></record>

