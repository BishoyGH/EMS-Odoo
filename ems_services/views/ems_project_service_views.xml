<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ems_service_list" model="ir.ui.view">
        <field name="name">ems.project.service.list</field>
        <field name="model">ems.project.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="cost_code"/><field name="name"/><field name="project_id"/>
                <field name="discipline"/><field name="manager_id"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="fee" sum="Total"/><field name="budget_hours" sum="Total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_ems_service_form" model="ir.ui.view">
        <field name="name">ems.project.service.form</field>
        <field name="model">ems.project.service</field>
        <field name="arch" type="xml">
            <form>
                <header><field name="state" widget="statusbar" options="{'clickable': '1'}"/></header>
                <sheet>
                    <group>
                        <group>
                            <field name="project_id"/><field name="code"/><field name="cost_code"/>
                            <field name="name"/><field name="discipline"/><field name="product_id"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/><field name="fee"/><field name="budget_hours"/>
                            <field name="manager_id"/><field name="date_start"/><field name="date_end"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_ems_cost_codes" model="ir.actions.act_window">
        <field name="name">Cost Codes</field>
        <field name="res_model">ems.project.service</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
