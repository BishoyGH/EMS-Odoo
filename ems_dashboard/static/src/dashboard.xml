<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <div t-name="ems_dashboard.Dashboard" class="o_action o_ems_dashboard">
        <div class="o_ems_dash_scroll">
            <t t-if="this.state.loading">
                <div class="o_ems_dash_loading text-muted p-5">Loading dashboard...</div>
            </t>
            <t t-elif="this.state.error">
                <div class="alert alert-danger m-4" role="alert"><t t-out="this.state.error"/></div>
            </t>
            <t t-else="">
                <div class="o_ems_dash_header">
                    <div>
                        <h1 class="o_ems_dash_title" t-out="this.state.data.title"/>
                        <div class="o_ems_dash_updated text-muted">Updated <t t-out="this.state.data.updated"/> (UTC)</div>
                    </div>
                    <button class="btn btn-secondary" t-on-click="this.refresh"><i class="fa fa-refresh me-1"/>Refresh</button>
                </div>
                <t t-foreach="this.state.data.sections" t-as="section" t-key="section_index">
                    <h2 class="o_ems_dash_section" t-out="section.title"/>
                    <div class="o_ems_tiles">
                        <t t-foreach="section.tiles" t-as="tile" t-key="tile_index">
                            <div t-attf-class="o_ems_tile {{ this.toneClass(tile.tone) }} {{ tile.action ? 'o_ems_tile_clickable' : '' }}"
                                 t-on-click="() => this.openTile(tile)">
                                <div class="o_ems_tile_label" t-out="tile.label"/>
                                <div class="o_ems_tile_value" t-out="this.formatValue(tile.value, tile.fmt)"/>
                                <div class="o_ems_tile_sub" t-if="tile.sub" t-out="tile.sub"/>
                            </div>
                        </t>
                    </div>
                </t>
                <div class="o_ems_charts">
                    <t t-foreach="this.state.data.charts" t-as="chart" t-key="chart_index">
                        <div class="o_ems_chart">
                            <h3 class="o_ems_chart_title" t-out="chart.title"/>
                            <div t-if="!chart.items.length" class="text-muted">No data yet.</div>
                            <t t-foreach="chart.items" t-as="item" t-key="item_index">
                                <div class="o_ems_bar_row">
                                    <div class="o_ems_bar_label" t-att-title="item.label" t-out="item.label"/>
                                    <div class="o_ems_bar_track">
                                        <div t-attf-class="o_ems_bar_fill {{ item.over || item.value &lt; 0 ? 'o_ems_bar_bad' : '' }}"
                                             t-attf-style="width: {{ item.pct }}%"/>
                                    </div>
                                    <div class="o_ems_bar_value" t-out="this.formatValue(item.value, chart.fmt)"/>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </t>
        </div>
    </div>
</templates>
