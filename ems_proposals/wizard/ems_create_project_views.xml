<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ems_create_project_wizard" model="ir.ui.view">
        <field name="name">ems.create.project.wizard.form</field>
        <field name="model">ems.create.project.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="lead_id" invisible="1"/>
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="contract_value"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Create Project" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
