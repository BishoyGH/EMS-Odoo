<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_ems" model="res.groups.privilege">
        <field name="name">EMS</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_ems_user" model="res.groups">
        <field name="privilege_id" ref="res_groups_privilege_ems"/>
        <field name="name">EMS: User</field>
        <field name="comment">Read and work on EMS records. Cannot see internal cost rates.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_ems_manager" model="res.groups">
        <field name="privilege_id" ref="res_groups_privilege_ems"/>
        <field name="name">EMS: Manager</field>
        <field name="comment">Create, confirm, approve and delete EMS records.</field>
        <field name="implied_ids" eval="[(4, ref('group_ems_user'))]"/>
    </record>
    <record id="group_ems_rates" model="res.groups">
        <field name="privilege_id" ref="res_groups_privilege_ems"/>
        <field name="name">EMS: Rates Manager</field>
        <field name="comment">Can see internal cost rates and bank details (replaces the exe rates vault).</field>
        <field name="implied_ids" eval="[(4, ref('group_ems_user'))]"/>
    </record>
    <record id="group_ems_admin" model="res.groups">
        <field name="privilege_id" ref="res_groups_privilege_ems"/>
        <field name="name">EMS: Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_ems_manager')), (4, ref('group_ems_rates'))]"/>
    </record>
    <!-- The administrator can use every EMS app straight after installation -->
    <function model="res.users" name="write"
              eval="[[ref('base.user_admin')], {'group_ids': [(4, ref('ems_base.group_ems_admin'))]}]"/>
</odoo>
