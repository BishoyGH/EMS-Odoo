<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ems_allocation_list" model="ir.ui.view">
        <field name="name">ems.allocation.list</field>
        <field name="model">ems.allocation</field>
        <field name="arch" type="xml">
            <list decoration-danger="overbooked" decoration-muted="tentative">
                <field name="employee_id"/><field name="project_id"/><field name="service_id" optional="show"/>
                <field name="name"/><field name="date_from"/><field name="date_to"/>
                <field name="hours_per_day"/><field name="days"/><field name="hours" sum="Total"/>
                <field name="cost" sum="Total" groups="ems_base.group_ems_rates"/>
                <field name="tentative"/><field name="overbooked" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_ems_allocation_form" model="ir.ui.view">
        <field name="name">ems.allocation.form</field>
        <field name="model">ems.allocation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not overbooked">
                        This employee is booked above daily capacity during this period.
                    </div>
                    <group>
                        <group>
                            <field name="name"/><field name="employee_id"/><field name="project_id"/>
                            <field name="service_id"/><field name="milestone_id"/><field name="overbooked" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_from"/><field name="date_to"/><field name="hours_per_day"/>
                            <field name="tentative"/><field name="days"/><field name="hours"/>
                            <field name="cost" groups="ems_base.group_ems_rates"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_ems_allocation_calendar" model="ir.ui.view">
        <field name="name">ems.allocation.calendar</field>
        <field name="model">ems.allocation</field>
        <field name="arch" type="xml">
            <calendar date_start="date_from" date_stop="date_to" string="Planner" color="employee_id" mode="month" quick_create="0">
                <field name="employee_id"/><field name="project_id"/><field name="hours_per_day"/>
            </calendar>
        </field>
    </record>
    <record id="view_ems_allocation_planner_pivot" model="ir.ui.view">
        <field name="name">ems.allocation.planner.pivot</field>
        <field name="model">ems.allocation</field>
        <field name="arch" type="xml">
            <pivot string="Planner">
                <field name="employee_id" type="row"/>
                <field name="week_start" interval="week" type="col"/>
                <field name="hours" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_ems_allocation_cost_pivot" model="ir.ui.view">
        <field name="name">ems.allocation.cost.pivot</field>
        <field name="model">ems.allocation</field>
        <field name="arch" type="xml">
            <pivot string="Project Cost">
                <field name="project_id" type="row"/>
                <field name="employee_id" type="row"/>
                <field name="hours" type="measure"/>
                <field name="cost" type="measure" groups="ems_base.group_ems_rates"/>
            </pivot>
        </field>
    </record>
    <record id="view_ems_allocation_graph" model="ir.ui.view">
        <field name="name">ems.allocation.graph</field>
        <field name="model">ems.allocation</field>
        <field name="arch" type="xml">
            <graph string="Utilisation" type="bar">
                <field name="employee_id"/>
                <field name="hours" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_ems_allocation_search" model="ir.ui.view">
        <field name="name">ems.allocation.search</field>
        <field name="model">ems.allocation</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/><field name="project_id"/><field name="name"/>
                <filter name="tentative" string="Tentative" domain="[('tentative', '=', True)]"/>
                <filter name="firm" string="Confirmed" domain="[('tentative', '=', False)]"/>
                <group>
                    <filter name="g_emp" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="g_proj" string="Project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ems_planner" model="ir.actions.act_window">
        <field name="name">Planner</field>
        <field name="res_model">ems.allocation</field>
        <field name="view_mode">calendar,pivot,list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_ems_allocation_calendar')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_ems_allocation_planner_pivot')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_ems_allocation_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_ems_allocation_form')})]"/>
    </record>
    <record id="action_ems_utilisation" model="ir.actions.act_window">
        <field name="name">Utilisation</field>
        <field name="res_model">ems.allocation</field>
        <field name="view_mode">graph,pivot</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_ems_allocation_graph')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_ems_allocation_planner_pivot')})]"/>
    </record>
    <record id="action_ems_project_cost" model="ir.actions.act_window">
        <field name="name">Project Cost</field>
        <field name="res_model">ems.allocation</field>
        <field name="view_mode">pivot,list</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_ems_allocation_cost_pivot')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_ems_allocation_list')})]"/>
    </record>
    <record id="action_ems_allocations" model="ir.actions.act_window">
        <field name="name">Allocations</field>
        <field name="res_model">ems.allocation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ems_allocation_search"/>
    </record>
</odoo>
