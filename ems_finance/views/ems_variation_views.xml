<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ems_variation_list" model="ir.ui.view">
        <field name="name">ems.variation.list</field>
        <field name="model">ems.variation</field>
        <field name="arch" type="xml">
            <list string="Variations" decoration-success="state == 'approved'" decoration-muted="state in ('rejected', 'cancel')">
                <field name="name"/>
                <field name="project_id"/>
                <field name="title"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Total"/>
                <field name="added_days"/>
                <field name="signed_by" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'" decoration-danger="state in ('rejected', 'cancel')"/>
            </list>
        </field>
    </record>
    <record id="view_ems_variation_form" model="ir.ui.view">
        <field name="name">ems.variation.form</field>
        <field name="model">ems.variation</field>
        <field name="arch" type="xml">
            <form string="Variation">
                <header>
                    <button name="action_submit" string="Submit to Client" type="object" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve (signed)" type="object" class="btn-primary"
                            invisible="state not in ('draft', 'submitted')" groups="ems_base.group_ems_manager"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state not in ('draft', 'submitted')"/>
                    <button name="action_revoke" string="Revoke" type="object" invisible="state != 'approved'"
                            groups="ems_base.group_ems_manager"/>
                    <button name="action_draft" string="Back to Proposed" type="object" invisible="state not in ('rejected', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h2><field name="title" placeholder="Title (for example PBSD scope)"/></h2>
                    </div>
                    <group>
                        <group string="Commercial">
                            <field name="project_id" readonly="state == 'approved'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" readonly="state == 'approved'"/>
                            <field name="added_budget" readonly="state == 'approved'"/>
                            <field name="added_days" readonly="state == 'approved'"/>
                            <field name="quotation_ref"/>
                        </group>
                        <group string="Signed client approval">
                            <field name="signed_by" readonly="state == 'approved'"/>
                            <field name="signed_date" readonly="state == 'approved'"/>
                            <field name="signed_file" filename="signed_filename" readonly="state == 'approved'"/>
                            <field name="signed_filename" invisible="1"/>
                            <field name="technical_owner_id"/>
                            <field name="crs_ref"/>
                            <field name="approved_by_id"/>
                            <field name="approved_on"/>
                        </group>
                    </group>
                    <field name="reason" placeholder="Scope change and reason..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_ems_variation_search" model="ir.ui.view">
        <field name="name">ems.variation.search</field>
        <field name="model">ems.variation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="title"/><field name="project_id"/>
                <filter name="pending" string="Awaiting approval" domain="[('state', 'in', ('draft', 'submitted'))]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <group><filter name="grp_project" string="Project" context="{'group_by': 'project_id'}"/>
                       <filter name="grp_state" string="Status" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_ems_variations" model="ir.actions.act_window">
        <field name="name">Variations</field>
        <field name="res_model">ems.variation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Register a variation</p>
            <p>Revenue and budget only increase once the signed client approval is attached.</p></field>
    </record>
    <record id="view_ems_wbs_template_list" model="ir.ui.view">
        <field name="name">ems.wbs.template.list</field>
        <field name="model">ems.wbs.template</field>
        <field name="arch" type="xml">
            <list string="WBS Template P0-P7" editable="bottom" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="gate"/>
                <field name="budget_pct" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="action_ems_wbs_template" model="ir.actions.act_window">
        <field name="name">WBS Template (P0-P7)</field>
        <field name="res_model">ems.wbs.template</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
