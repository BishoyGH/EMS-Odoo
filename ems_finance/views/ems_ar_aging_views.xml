<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ems_ar_aging_list" model="ir.ui.view">
        <field name="name">ems.ar.aging.list</field>
        <field name="model">ems.ar.aging</field>
        <field name="arch" type="xml">
            <list string="AR Aging" create="0" edit="0" decoration-danger="days_overdue > 60" decoration-warning="days_overdue > 0 and days_overdue &lt;= 60">
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="move_id"/>
                <field name="due_date"/>
                <field name="days_overdue"/>
                <field name="bucket" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_total" sum="Total"/>
                <field name="residual" sum="Outstanding"/>
            </list>
        </field>
    </record>
    <record id="view_ems_ar_aging_pivot" model="ir.ui.view">
        <field name="name">ems.ar.aging.pivot</field>
        <field name="model">ems.ar.aging</field>
        <field name="arch" type="xml">
            <pivot string="AR Aging">
                <field name="partner_id" type="row"/>
                <field name="bucket" type="col"/>
                <field name="residual" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_ems_ar_aging_graph" model="ir.ui.view">
        <field name="name">ems.ar.aging.graph</field>
        <field name="model">ems.ar.aging</field>
        <field name="arch" type="xml">
            <graph string="AR by bucket" type="bar">
                <field name="bucket"/>
                <field name="residual" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_ems_ar_aging_search" model="ir.ui.view">
        <field name="name">ems.ar.aging.search</field>
        <field name="model">ems.ar.aging</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/><field name="project_id"/><field name="move_id"/>
                <filter name="overdue" string="Overdue" domain="[('days_overdue', '>', 0)]"/>
                <group><filter name="grp_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                       <filter name="grp_project" string="Project" context="{'group_by': 'project_id'}"/>
                       <filter name="grp_bucket" string="Bucket" context="{'group_by': 'bucket'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_ems_ar_aging" model="ir.actions.act_window">
        <field name="name">AR Aging</field>
        <field name="res_model">ems.ar.aging</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>
</odoo>
