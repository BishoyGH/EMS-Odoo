<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ems_timesheet_list" model="ir.ui.view">
        <field name="name">ems.timesheet.list</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <list string="Timesheets" editable="bottom" decoration-danger="ems_overcapacity" decoration-success="ems_state == 'approved'"
                  sample="1" default_order="date desc, id desc">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="project_id" required="1"/>
                <field name="task_id" required="1" domain="[('project_id', '=', project_id)]"/>
                <field name="name" string="Activity"/>
                <field name="unit_amount" widget="float_time" sum="Hours"/>
                <field name="ems_out_of_scope" optional="hide"/>
                <field name="ems_cost_rate" optional="hide"/>
                <field name="ems_cost_amount" optional="show" sum="Cost"/>
                <field name="ems_overcapacity" column_invisible="1"/>
                <field name="ems_state" widget="badge" decoration-info="ems_state == 'submitted'" decoration-success="ems_state == 'approved'"
                       decoration-danger="ems_state == 'rejected'"/>
            </list>
        </field>
    </record>
    <record id="view_ems_timesheet_search" model="ir.ui.view">
        <field name="name">ems.timesheet.search</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/><field name="project_id"/><field name="task_id"/><field name="name"/>
                <filter name="mine" string="My timesheets" domain="[('user_id', '=', uid)]"/>
                <filter name="to_approve" string="To approve" domain="[('ems_state', '=', 'submitted')]"/>
                <filter name="draft" string="Draft" domain="[('ems_state', '=', 'draft')]"/>
                <filter name="approved" string="Approved" domain="[('ems_state', '=', 'approved')]"/>
                <filter name="out_scope" string="Outside scope" domain="[('ems_out_of_scope', '=', True)]"/>
                <group>
                    <filter name="grp_week" string="Week" context="{'group_by': 'ems_week_start'}"/>
                    <filter name="grp_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="grp_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="grp_wbs" string="WBS" context="{'group_by': 'ems_wbs_code'}"/>
                    <filter name="grp_state" string="Approval" context="{'group_by': 'ems_state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_ems_timesheet_pivot" model="ir.ui.view">
        <field name="name">ems.timesheet.pivot</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <pivot string="Timesheets">
                <field name="employee_id" type="row"/>
                <field name="ems_week_start" interval="week" type="col"/>
                <field name="unit_amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_ems_timesheet_graph" model="ir.ui.view">
        <field name="name">ems.timesheet.graph</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <graph string="Hours by WBS" type="bar">
                <field name="ems_wbs_code"/>
                <field name="unit_amount" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_ems_timesheets" model="ir.actions.act_window">
        <field name="name">Timesheets</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="domain">[('project_id', '!=', False)]</field>
        <field name="search_view_id" ref="view_ems_timesheet_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_ems_timesheet_list')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_ems_timesheet_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_ems_timesheet_graph')})]"/>
        <field name="context">{'search_default_mine': 1}</field>
    </record>
    <record id="action_ems_timesheets_approve" model="ir.actions.act_window">
        <field name="name">Timesheets to Approve</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="domain">[('project_id', '!=', False)]</field>
        <field name="search_view_id" ref="view_ems_timesheet_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_ems_timesheet_list')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_ems_timesheet_pivot')})]"/>
        <field name="context">{'search_default_to_approve': 1, 'search_default_grp_week': 1, 'search_default_grp_employee': 1}</field>
    </record>

    <record id="server_action_ems_ts_submit" model="ir.actions.server">
        <field name="name">Submit for approval</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="binding_model_id" ref="analytic.model_account_analytic_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_ems_submit()</field>
    </record>
    <record id="server_action_ems_ts_approve" model="ir.actions.server">
        <field name="name">Approve (snapshot cost rate)</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="binding_model_id" ref="analytic.model_account_analytic_line"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('ems_base.group_ems_manager'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_ems_approve()</field>
    </record>
    <record id="server_action_ems_ts_reject" model="ir.actions.server">
        <field name="name">Reject</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="binding_model_id" ref="analytic.model_account_analytic_line"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('ems_base.group_ems_manager'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_ems_reject()</field>
    </record>
</odoo>
