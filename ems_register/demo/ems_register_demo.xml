<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ems_base.project_szr" model="project.project">
        <field name="ems_sub_budget">20000</field>
    </record>
    <record id="vendor_demo" model="res.partner">
        <field name="name">Demo Geotechnical Consultants LLC</field>
        <field name="is_company" eval="True"/>
        <field name="supplier_rank">1</field>
        <field name="ems_category">company</field>
    </record>
    <record id="po_demo" model="purchase.order">
        <field name="partner_id" ref="vendor_demo"/>
        <field name="ems_project_id" ref="ems_base.project_szr"/>
        <field name="ems_scope"><![CDATA[<p>Peer review of geotechnical report.]]></field>
        <field name="ems_payment_days">30</field>
    </record>
    <record id="po_demo_line" model="purchase.order.line">
        <field name="order_id" ref="po_demo"/>
        <field name="name">Geotechnical peer review (lump sum)</field>
        <field name="product_qty">1</field>
        <field name="price_unit">10000</field>
    </record>
    <record id="po_demo_ms1" model="ems.po.milestone"><field name="order_id" ref="po_demo"/><field name="name">On acceptance</field><field name="percent">30</field></record>
    <record id="po_demo_ms2" model="ems.po.milestone"><field name="order_id" ref="po_demo"/><field name="name">On issue of report</field><field name="percent">70</field></record>
</odoo>
