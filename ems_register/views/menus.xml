<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_ems_register_pos" model="ir.actions.act_window">
        <field name="name">Purchase Orders / LOA</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ems_project_id', '!=', False)]</field>
    </record>
    <record id="action_ems_vendor_bills" model="ir.actions.act_window">
        <field name="name">Vendor Bills</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'in_invoice')]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
    </record>
    <menuitem id="menu_ems_register_root" name="EMS Register" sequence="20"
              groups="ems_base.group_ems_user" web_icon="ems_base,static/description/icon.png"/>
    <menuitem id="menu_ems_reg_projects" name="Projects" parent="menu_ems_register_root" action="ems_base.action_ems_projects" sequence="10"/>
    <menuitem id="menu_ems_reg_customers" name="Customers" parent="menu_ems_register_root" action="ems_base.action_ems_customers" sequence="20"/>
    <menuitem id="menu_ems_reg_vendors" name="Vendors" parent="menu_ems_register_root" action="ems_base.action_ems_vendors" sequence="30"/>
    <menuitem id="menu_ems_reg_pos" name="Purchase Orders" parent="menu_ems_register_root" action="action_ems_register_pos" sequence="40"/>
    <menuitem id="menu_ems_reg_bills" name="Vendor Bills" parent="menu_ems_register_root" action="action_ems_vendor_bills" sequence="50"/>
    <menuitem id="menu_ems_reg_terms" name="Standard Terms" parent="menu_ems_register_root" action="action_ems_loa_clause" sequence="90"
              groups="ems_base.group_ems_manager"/>
</odoo>
