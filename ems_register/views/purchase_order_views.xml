<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_ems" model="ir.ui.view">
        <field name="name">purchase.order.form.ems</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_issue_loa" string="Issue for Signature" type="object"
                        invisible="state != 'draft'" groups="ems_base.group_ems_manager"/>
                <button name="action_ems_milestones_from_lines" string="Milestones from Lines" type="object"
                        invisible="state not in ('draft', 'sent')"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="not ems_milestone_ids or ems_milestone_pct == 100">
                    Payment milestones add up to <field name="ems_milestone_pct" class="oe_inline fw-bold"/>%, not 100%.
                </div>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <widget name="web_ribbon" title="Signed" bg_color="text-bg-success" invisible="not ems_signed"/>
            </xpath>
            <xpath expr="//field[@name='date_planned']" position="after">
                <field name="ems_project_id" options="{'no_create': True}"/>
                <field name="ems_quotation_ref"/>
                <field name="ems_quotation_date"/>
                <field name="ems_tax_treatment"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Letter of Appointment" name="ems_loa" groups="ems_base.group_ems_user">
                    <group>
                        <group>
                            <field name="ems_loa_ref"/>
                            <field name="ems_loa_revision"/>
                            <field name="ems_loa_date"/>
                            <field name="ems_signed"/>
                            <field name="ems_signed_by"/>
                        </group>
                        <group>
                            <field name="ems_date_start"/>
                            <field name="ems_completion_basis"/>
                            <field name="ems_duration"/>
                            <field name="ems_duration_unit"/>
                            <field name="ems_document_location"/>
                        </group>
                    </group>
                    <separator string="Scope of Services"/>
                    <field name="ems_scope"/>
                    <separator string="Deliverables"/>
                    <field name="ems_deliverables"/>
                    <separator string="Exclusions"/>
                    <field name="ems_exclusions"/>
                </page>
                <page string="Payment Terms" name="ems_payment" groups="ems_base.group_ems_user">
                    <group>
                        <group>
                            <field name="ems_advance_pct"/>
                            <field name="ems_retention_pct"/>
                            <field name="ems_retention_release"/>
                            <field name="ems_payment_days"/>
                        </group>
                        <group>
                            <field name="ems_milestone_pct"/>
                            <field name="ems_next_action"/>
                            <field name="ems_follow_up_date"/>
                        </group>
                    </group>
                    <field name="ems_milestone_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="percent"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="amount"/>
                            <field name="due_on"/>
                        </list>
                    </field>
                </page>
                <page string="Conditions" name="ems_conditions" groups="ems_base.group_ems_user">
                    <group>
                        <group>
                            <field name="ems_governing_law"/>
                            <field name="ems_forum"/>
                            <field name="ems_liability_cap"/>
                            <field name="ems_insurance"/>
                            <field name="ems_delay_damages"/>
                        </group>
                        <group>
                            <field name="ems_notice_days"/>
                            <field name="ems_cure_days"/>
                            <field name="ems_restriction_months"/>
                            <field name="ems_review_days"/>
                            <field name="ems_rep_id"/>
                            <field name="ems_notice_email"/>
                        </group>
                    </group>
                    <separator string="Special Conditions"/>
                    <field name="ems_special_conditions"/>
                    <separator string="Terms &amp; Conditions"/>
                    <field name="ems_terms"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_ems_documents" model="ir.ui.view">
        <field name="name">purchase.order.form.ems.documents</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="ems_register.purchase_order_form_ems"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Documents" name="ems_documents" groups="ems_base.group_ems_user">
                    <field name="ems_document_ids" context="{'default_res_model': 'purchase.order'}"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_list_ems" model="ir.ui.view">
        <field name="name">purchase.order.list.ems</field>
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <list string="Purchase Orders / LOA" decoration-muted="state == 'cancel'" decoration-success="ems_signed"
                  decoration-warning="not ems_signed and state in ('sent', 'purchase')">
                <field name="name" string="PO"/>
                <field name="ems_loa_ref" optional="show"/>
                <field name="ems_project_id" optional="show"/>
                <field name="partner_id" string="Vendor"/>
                <field name="date_order" optional="show"/>
                <field name="ems_follow_up_date" optional="hide"/>
                <field name="ems_next_action" optional="hide"/>
                <field name="ems_milestone_pct" string="Milestones %" optional="hide"/>
                <field name="ems_signed" widget="boolean" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_untaxed" widget="monetary" sum="Total ex VAT" optional="show"/>
                <field name="amount_total" widget="monetary" sum="Total" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'purchase'" decoration-info="state in ('draft', 'sent')"
                       decoration-danger="state == 'cancel'"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
            </list>
        </field>
    </record>
    <record id="purchase_order_search_ems" model="ir.ui.view">
        <field name="name">purchase.order.search.ems</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="ems_unsigned" string="LOA awaiting signature" domain="[('ems_signed', '=', False), ('state', 'in', ('draft', 'sent'))]"/>
                <filter name="ems_signed" string="Signed" domain="[('ems_signed', '=', True)]"/>
                <filter name="ems_follow_up_due" string="Follow-up due" domain="[('ems_follow_up_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <field name="ems_project_id"/>
                <field name="ems_loa_ref"/>
                <group name="ems_groupby">
                    <filter name="group_ems_project" string="Project" context="{'group_by': 'ems_project_id'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
