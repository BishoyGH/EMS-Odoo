<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ems_loa_clause_list" model="ir.ui.view">
        <field name="name">ems.loa.clause.list</field>
        <field name="model">ems.loa.clause</field>
        <field name="arch" type="xml">
            <list><field name="sequence" widget="handle"/><field name="title"/></list>
        </field>
    </record>
    <record id="view_ems_loa_clause_form" model="ir.ui.view">
        <field name="name">ems.loa.clause.form</field>
        <field name="model">ems.loa.clause</field>
        <field name="arch" type="xml">
            <form><sheet><group><field name="title"/><field name="sequence"/></group><field name="body"/></sheet></form>
        </field>
    </record>
    <record id="action_ems_loa_clause" model="ir.actions.act_window">
        <field name="name">Standard Terms (LOA Clauses)</field>
        <field name="res_model">ems.loa.clause</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
